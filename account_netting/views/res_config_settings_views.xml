<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Accounting settings: netting block after Vendor Payments -->
    <record id="res_config_settings_view_form_netting" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.netting</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='print_vendor_checks_setting_container']" position="after">
                <block title="Netting" id="netting_setting_container">
                    <setting id="netting_journal"
                             string="Netting Journal"
                             company_dependent="1"
                             help="Journal of the entries that settle customer invoices against open vendor bills">
                        <field name="netting_journal_id" options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
