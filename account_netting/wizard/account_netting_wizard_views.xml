<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Netting popup opened by the invoice Confirm button -->
    <record id="account_netting_wizard_view_form" model="ir.ui.view">
        <field name="name">account.netting.wizard.form</field>
        <field name="model">account.netting.wizard</field>
        <field name="arch" type="xml">
            <form string="Net Against Open Bills">
                <field name="has_mandatory" invisible="1"/>
                <field name="company_currency_id" invisible="1"/>
                <p class="text-muted">
                    This partner has open vendor bills. Selected bills are settled against the
                    invoice, oldest first, up to the invoice amount.
                </p>
                <group>
                    <group>
                        <field name="invoice_id"/>
                        <field name="partner_id"/>
                    </group>
                    <group>
                        <field name="invoice_amount"/>
                        <field name="selected_amount"/>
                        <field name="netting_amount"/>
                    </group>
                </group>
                <!-- Open bills; bills that must be netted cannot be unticked -->
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="mandatory" column_invisible="1"/>
                        <field name="bill_currency_id" column_invisible="1"/>
                        <field name="company_currency_id" column_invisible="1"/>
                        <field name="selected" widget="boolean_toggle" readonly="mandatory"/>
                        <field name="bill_id"/>
                        <field name="bill_date"/>
                        <field name="amount_residual"/>
                        <field name="amount_residual_company"/>
                    </list>
                </field>
                <footer>
                    <button name="action_post_without_netting"
                            string="Post Without Netting"
                            type="object"
                            class="btn-secondary"
                            invisible="has_mandatory"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>