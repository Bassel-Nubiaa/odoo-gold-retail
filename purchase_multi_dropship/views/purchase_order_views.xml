<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Purchase order form: customer allocations and the button that generates their orders -->
    <record id="purchase_order_form_multi_dropship" model="ir.ui.view">
        <field name="name">purchase.order.form.multi.dropship</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <!-- Header: generate the customer orders of pending allocations -->
            <xpath expr="//header/field[@name='state']" position="before">
                <field name="has_pending_allocations" invisible="1"/>
                <button name="action_generate_customer_orders"
                        type="object"
                        string="Generate Customer Orders"
                        class="btn-primary"
                        invisible="state not in ('purchase', 'done') or not has_pending_allocations"/>
            </xpath>

            <!-- Allocations tab: only on confirmed orders with something to allocate or already allocated -->
            <page name="products" position="after">
                <page name="customer_allocations"
                      string="Customer Allocations"
                      invisible="state not in ('purchase', 'done') or (not can_allocate and not allocation_ids)">
                    <field name="allocation_product_ids" invisible="1"/>
                    <field name="can_allocate" invisible="1"/>
                    <field name="allocation_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="sale_line_id" column_invisible="1"/>
                            <field name="price_currency_id" column_invisible="1"/>
                            <!-- Locked once the customer order exists -->
                            <field name="partner_id" options="{'no_create': True}" readonly="sale_line_id"/>
                            <field name="product_id"
                                   domain="[('id', 'in', parent.allocation_product_ids)]"
                                   options="{'no_create': True}"
                                   readonly="sale_line_id"/>
                            <field name="product_qty" readonly="sale_line_id"/>
                            <field name="product_uom_id"/>
                            <field name="currency_id"
                                   options="{'no_create': True}"
                                   readonly="sale_line_id"
                                   groups="base.group_multi_currency"/>
                            <field name="price_unit" readonly="sale_line_id"/>
                            <field name="price_subtotal"/>
                            <!-- Results of the generation -->
                            <field name="sale_order_id" readonly="1"/>
                            <field name="picking_id" readonly="1"/>
                        </list>
                    </field>
                </page>
            </page>

        </field>
    </record>
</odoo>